{
  "name": "techmoney-invest-customer-pilot",
  "main": "cloudflare/customer-pilot-worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "INVEST_PILOT_CREDITS",
      "database_name": "techmoney-invest-pilot-credits",
      "database_id": "3b00458c-f64c-44cc-801a-36f2579c82bc",
      "migrations_dir": "cloudflare/pilot-credit-migrations"
    }
  ],
  "vars": {
    "INVEST_CUSTOMER_PILOT_ORIGIN": "https://techmoney-invest-customer-pilot.techmoney.workers.dev"
  }
}
