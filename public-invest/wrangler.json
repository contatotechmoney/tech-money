{
  "name": "techmoney-invest-interest",
  "main": "../dist/public-invest/worker.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "no_bundle": true,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "hyperdrive": [
    {
      "binding": "INTEREST_DATABASE",
      "id": "090bdfc5d2a8489eb1ccb8ea766e8566"
    }
  ],
  "vars": {
    "INTEREST_ORIGIN": "https://techmoney-invest-interest.techmoney.workers.dev",
    "INTEREST_TEST_MODE": "false"
  },
  "secrets": {
    "required": [
      "INTEREST_RATE_KEY",
      "INTEREST_ACCESS_ISSUER",
      "INTEREST_ACCESS_AUD",
      "INTEREST_OWNER_EMAIL"
    ]
  },
  "services": [
    {
      "binding": "INVEST_NOTIFICATIONS",
      "service": "sistema",
      "entrypoint": "InvestNotifications"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
